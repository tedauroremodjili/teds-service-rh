# =============================================================================
# TED'S SERVICE — Variables d'environnement
# =============================================================================
# Copier ce fichier vers .env puis renseigner les valeurs reelles.
# .env ne doit JAMAIS etre commite (voir .gitignore).

# --- Base de donnees MySQL ---
DATABASE_URL="mysql://root:MOT_DE_PASSE@localhost:3306/teds_rh"

# --- Session (module 1 : authentification) ---
# Cle de signature du cookie de session. Generer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="a-remplacer-par-une-cle-aleatoire-de-32-octets"
# Duree de validite de la session, en secondes (8 h par defaut).
SESSION_MAX_AGE=28800

# --- Application ---
NEXT_PUBLIC_APP_NAME="TED'S SERVICE"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
